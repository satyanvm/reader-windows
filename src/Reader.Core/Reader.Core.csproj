<Project Sdk="Microsoft.NET.Sdk">
  <!-- Everything that isn't UI: positions, persistence, sync, the restore state machine, the
       flowing-text pipeline and pagination. Portable (net8.0), so it is unit-tested on any OS;
       the Windows-only pieces (Windows.Data.Pdf rendering, Windows.Media.Ocr) live in Reader.App
       behind IPageRasterizer and IOcr. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Reader.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="PdfPig" Version="0.1.11" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Text\Hyphenation\hyph-en-us.pat.txt" LogicalName="hyph-en-us.pat.txt" />
    <EmbeddedResource Include="Text\Hyphenation\hyph-en-us.hyp.txt" LogicalName="hyph-en-us.hyp.txt" />
    <None Include="Text\Hyphenation\NOTICE.txt" CopyToOutputDirectory="PreserveNewest" Link="licenses\hyphenation-NOTICE.txt" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Reader.Core.Tests" />
  </ItemGroup>
</Project>
