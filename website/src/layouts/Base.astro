---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site.config';

interface Props {
  title: string;
  description?: string;
  path?: string;
  jsonLd?: Record<string, unknown>;
  nav?: boolean;
}

const { title, description = site.description, path = '/', jsonLd, nav = true } = Astro.props;
const canonical = new URL(path, site.url).href;
const ogImage = new URL('/og.png', site.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/literata-latin.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}: ${site.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <!-- Platform detection runs before first paint, so the right download
         button and card show without a flash or layout shift. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var p = 'unknown';
        try {
          var uad = navigator.userAgentData;
          var hint = uad && uad.platform ? uad.platform.toLowerCase() : '';
          var ua = navigator.userAgent || '';
          var touchMac = /Macintosh/.test(ua) && navigator.maxTouchPoints > 1; // iPadOS reports as Mac
          if (hint) {
            if (hint === 'android') p = 'android';
            else if (hint === 'ios' || hint === 'ipados') p = 'iphone';
            else if (hint === 'macos') p = touchMac ? 'iphone' : 'mac';
            else if (hint === 'windows') p = 'windows';
          } else if (/Android/i.test(ua)) p = 'android';
          else if (/iPhone|iPad|iPod/i.test(ua) || touchMac) p = 'iphone';
          else if (/Macintosh|Mac OS X/i.test(ua)) p = 'mac';
          else if (/Windows/i.test(ua)) p = 'windows';
        } catch (e) {}
        d.setAttribute('data-platform', p);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header nav={nav} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <script>
      // Fade-and-rise on scroll. CSS only hides .reveal when motion is allowed.
      const els = document.querySelectorAll<HTMLElement>('.reveal');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduced || !('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
