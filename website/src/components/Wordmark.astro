---
import { site } from '../site.config';
---

<span class="wordmark">
  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 6.5C10 5 7.2 4.5 4 4.75v13.5c3.2-.25 6 .25 8 1.75 2-1.5 4.8-2 8-1.75V4.75C16.8 4.5 14 5 12 6.5Z" />
    <path d="M12 6.5V20" />
  </svg>
  <span>{site.name}</span>
</span>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 18px;
    line-height: 24px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  svg {
    color: var(--accent);
  }
</style>
