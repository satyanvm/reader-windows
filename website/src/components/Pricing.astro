---
import { site, formatPrice, yearlySavingPercent } from '../site.config';
const { free, sync, pricingIsPlaceholder, footnote } = site.pricing;

const check =
  '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>';
---

<section id="pricing" class="section" aria-labelledby="pricing-title">
  <div class="container">
    <div class="section-head center reveal">
      <p class="eyebrow">Pricing</p>
      <h2 id="pricing-title">Free to read. Sync when you want it.</h2>
    </div>

    <div class="billing reveal">
      <div class="seg" role="group" aria-label="Billing period">
        <button type="button" data-period="monthly" aria-pressed="true">Monthly</button>
        <button type="button" data-period="yearly" aria-pressed="false">
          Yearly <span class="save">Save {yearlySavingPercent}%</span>
        </button>
      </div>
    </div>

    <div class="plans">
      <article class="plan reveal" aria-labelledby="plan-free">
        <h3 id="plan-free">{free.name}</h3>
        <p class="price">
          <span class="amount">{formatPrice(free.price)}</span><span class="per">, {free.caption}</span>
        </p>
        <p class="alt small muted">&nbsp;</p>
        <ul>
          {free.features.map((f) => <li><Fragment set:html={check} />{f}</li>)}
        </ul>
        <a class="btn btn-secondary" href="#download">Download free</a>
      </article>

      <article
        class="plan recommended reveal"
        aria-labelledby="plan-sync"
        data-monthly={formatPrice(sync.monthly)}
        data-yearly={formatPrice(sync.yearly)}
      >
        <p class="badge">Most popular</p>
        <h3 id="plan-sync">{sync.name}</h3>
        <p class="price" aria-live="polite">
          <span class="amount" data-amount>{formatPrice(sync.monthly)}</span><span class="per" data-per> / month</span>
        </p>
        <p class="alt small muted" data-alt>or {formatPrice(sync.yearly)} / year, save {yearlySavingPercent}%</p>
        <ul>
          {sync.features.map((f) => <li><Fragment set:html={check} />{f}</li>)}
        </ul>
        <a class="btn btn-primary" href="#download">Get {sync.name}</a>
      </article>
    </div>

    <p class="foot reveal">{footnote}</p>
    {pricingIsPlaceholder && <p class="placeholder small muted">Prices are placeholders.</p>}
  </div>
</section>

<style>
  .billing {
    display: flex;
    justify-content: center;
    margin-bottom: 32px;
  }

  .seg {
    display: inline-flex;
    padding: 4px;
    gap: 4px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: #fff;
  }

  .seg button {
    min-height: 40px;
    padding: 0 16px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    font: inherit;
    font-size: 15px;
    color: var(--body);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .seg button[aria-pressed='true'] {
    background: var(--band);
    color: var(--ink);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .save {
    font-size: 12px;
    line-height: 16px;
    font-weight: 600;
    color: var(--accent);
  }

  .plans {
    display: grid;
    gap: 20px;
    max-width: 800px;
    margin-inline: auto;
    align-items: stretch;
  }

  @media (min-width: 720px) {
    .plans {
      grid-template-columns: 1fr 1fr;
    }
  }

  .plan {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 32px 28px 28px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: #fff;
  }

  .recommended {
    border-color: var(--accent);
  }

  .badge {
    position: absolute;
    top: -12px;
    left: 28px;
    padding: 2px 10px;
    font-size: 12px;
    line-height: 20px;
    font-weight: 600;
    color: var(--accent);
    background: #fff;
    border: 1px solid var(--accent);
    border-radius: 999px;
  }

  .price {
    margin-top: 16px;
    color: var(--ink);
  }

  .amount {
    font-size: 40px;
    line-height: 48px;
    font-weight: 600;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .per {
    color: var(--body);
  }

  .alt {
    margin-top: 4px;
    min-height: 22px;
  }

  @media (max-width: 719px) {
    .alt:empty,
    .plan:not(.recommended) .alt {
      display: none;
    }
  }

  ul {
    list-style: none;
    margin: 24px 0 28px;
    padding: 0;
    display: grid;
    gap: 10px;
    flex: 1;
    align-content: start;
  }

  li {
    display: flex;
    gap: 10px;
    font-size: 16px;
    line-height: 24px;
  }

  li :global(svg) {
    flex: none;
    margin-top: 3px;
    color: var(--accent);
  }

  .plan .btn {
    width: 100%;
  }

  .foot {
    margin-top: 32px;
    text-align: center;
    color: var(--ink);
  }

  .placeholder {
    margin-top: 6px;
    text-align: center;
  }
</style>

<script>
  const card = document.querySelector<HTMLElement>('.plan.recommended');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-period]');
  if (card) {
    const amount = card.querySelector<HTMLElement>('[data-amount]')!;
    const per = card.querySelector<HTMLElement>('[data-per]')!;
    const alt = card.querySelector<HTMLElement>('[data-alt]')!;
    const monthlyAlt = alt.textContent;
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        const yearly = b.dataset.period === 'yearly';
        buttons.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
        amount.textContent = yearly ? card.dataset.yearly! : card.dataset.monthly!;
        per.textContent = yearly ? ' / year' : ' / month';
        alt.textContent = yearly ? `${card.dataset.monthly} / month if billed monthly` : monthlyAlt;
      }),
    );
  }
</script>
