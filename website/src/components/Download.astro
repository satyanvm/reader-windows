---
import { site } from '../site.config';

const icons: Record<string, string> = {
  android:
    '<rect x="5" y="9" width="14" height="10" rx="2"/><path d="M5 12a7 7 0 0 1 14 0"/><path d="m8 5.5-1.5-2"/><path d="m16 5.5 1.5-2"/><circle cx="9.5" cy="9.5" r=".4" fill="currentColor"/><circle cx="14.5" cy="9.5" r=".4" fill="currentColor"/><path d="M9 19v2"/><path d="M15 19v2"/>',
  mac: '<rect x="4" y="5" width="16" height="11" rx="1.5"/><path d="M2.5 19h19"/><path d="M4 16 2.5 19"/><path d="m20 16 1.5 3"/>',
  windows:
    '<rect x="4" y="4" width="7" height="7" rx=".5"/><rect x="13" y="4" width="7" height="7" rx=".5"/><rect x="4" y="13" width="7" height="7" rx=".5"/><rect x="13" y="13" width="7" height="7" rx=".5"/>',
  iphone: '<rect x="7" y="2.5" width="10" height="19" rx="2.5"/><path d="M10.5 5h3"/><path d="M11 18.5h2"/>',
};
---

<section id="download" class="section band" aria-labelledby="download-title">
  <div class="container">
    <div class="section-head center reveal">
      <p class="eyebrow">Download</p>
      <h2 id="download-title">Get {site.name}.</h2>
      <p>Available now for Android and Mac. Windows and iPhone are on the way.</p>
    </div>

    <ul class="cards">
      {
        site.platforms.map((p) => {
          const statusId = `status-${p.id}`;
          const meta = [p.version && `Version ${p.version}`, p.size].filter(Boolean).join(' · ');
          return (
            <li id={`download-${p.id}`} class="card reveal" data-platform={p.id}>
              <p class="detected small">Your device</p>
              <svg
                width="32"
                height="32"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={icons[p.id]}
              />
              <h3>{p.name}</h3>
              <p class="os small muted">{p.minOS}</p>
              <p id={statusId} class={`state small ${p.available ? 'is-available' : ''}`}>
                {p.available ? 'Available now' : 'Coming soon'}
              </p>

              <div class="action">
                {p.available ? (
                  <>
                    <a class="btn btn-primary" href={p.url}>
                      {p.label}
                    </a>
                    {p.alt && (
                      <a class="alt small" href={p.alt.url}>
                        {p.alt.label}
                      </a>
                    )}
                  </>
                ) : (
                  <>
                    <button type="button" class="btn" aria-disabled="true" aria-describedby={statusId}>
                      {p.label}
                      <span class="sr-only">, not available yet</span>
                    </button>
                    {p.notifyUrl && (
                      <a class="alt small" href={p.notifyUrl}>
                        Notify me<span class="sr-only"> when {p.name} is available</span>
                      </a>
                    )}
                  </>
                )}
              </div>

              {(meta || p.note) && (
                <div class="meta small muted">
                  {meta && <p>{meta}</p>}
                  {p.note && <p>{p.note}</p>}
                </div>
              )}
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }

  @media (min-width: 640px) {
    .cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1000px) {
    .cards {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 28px 24px 24px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 16px;
  }

  :global(html[data-platform='android']) .card[data-platform='android'],
  :global(html[data-platform='mac']) .card[data-platform='mac'],
  :global(html[data-platform='windows']) .card[data-platform='windows'],
  :global(html[data-platform='iphone']) .card[data-platform='iphone'] {
    border-color: var(--accent);
    box-shadow: inset 0 0 0 1px var(--accent);
    order: -1;
  }

  .detected {
    display: none;
    position: absolute;
    top: 20px;
    right: 20px;
    margin: 0;
    font-size: 12px;
    line-height: 18px;
    font-weight: 600;
    color: var(--accent);
  }

  :global(html[data-platform='android']) .card[data-platform='android'] .detected,
  :global(html[data-platform='mac']) .card[data-platform='mac'] .detected,
  :global(html[data-platform='windows']) .card[data-platform='windows'] .detected,
  :global(html[data-platform='iphone']) .card[data-platform='iphone'] .detected {
    display: block;
  }

  svg {
    color: var(--ink);
    margin-bottom: 16px;
  }

  .os {
    margin-top: 2px;
  }

  .action {
    margin-top: 24px;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 10px;
    flex: 1;
  }

  .action .btn {
    width: 100%;
    padding-inline: 12px;
  }

  .alt {
    align-self: center;
    padding: 4px 0;
  }

  .state {
    margin-top: 12px;
    font-weight: 600;
    color: var(--ink);
  }

  .state.is-available {
    color: var(--accent);
  }

  .meta {
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    display: grid;
    gap: 4px;
  }
</style>
